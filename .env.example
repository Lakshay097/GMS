# Environment Configuration Template — SchoolOps (self-managed authentication)
# Copy this file to .env.dev, .env.staging, or .env.production and fill in actual values.
# Never commit files with real secret values.
# Authentication is FULLY self-managed (FastAPI + Neon PostgreSQL). No Clerk, no
# external identity provider, no auth SaaS.

# Environment
ENV=development

# Database — Neon (serverless PostgreSQL)
DATABASE_URL=
# Read replica for reports/dashboards (R-61/Architecture §14).
# Leave blank in dev (falls back to DATABASE_URL with read-only transaction flag).
# In production: point at a Neon read-replica branch URL.
DATABASE_READ_REPLICA_URL=

# Authentication (self-managed)
# SESSION_TIMEOUT_MINUTES: sliding idle timeout — a session dies after this many
#   minutes of inactivity (extended automatically while the user is active).
SESSION_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS: hard ceiling — even an active session must
#   re-authenticate after this many hours.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# SESSION_COOKIE_NAME: HttpOnly cookie that carries the opaque session token.
SESSION_COOKIE_NAME=schoolops_session
# Background purge: expired auth_sessions rows older than SESSION_CLEANUP_GRACE_HOURS
#   are deleted automatically, every SESSION_PURGE_INTERVAL_MINUTES (per running instance).
SESSION_PURGE_INTERVAL_MINUTES=60
# Brute-force protection: lock an account after this many failed logins…
MAX_FAILED_LOGINS=5
# …for this many minutes.
LOCKOUT_MINUTES=15
# Password policy: minimum length (must also contain a letter and a number).
MIN_PASSWORD_LENGTH=10
# Password reset tokens are single-use and expire after this many minutes.
PASSWORD_RESET_TIMEOUT_MINUTES=30
# MFA is required for these roles when FEATURE_FLAG_MFA_ENABLED=true
MFA_REQUIRED_ROLES=Admin,SuperAdmin

# Security (Required in production)
# ENCRYPTION_KEY: Used to encrypt MFA secrets at rest (R-57)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key will invalidate existing encrypted MFA secrets
ENCRYPTION_KEY=
# PLATFORM_JWT_SECRET: HS256 signing of platform-issued tokens (tests/internal
# services only). User sessions do NOT use JWTs — they are opaque DB-backed tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_JWT_SECRET=
# INTERNAL_SCHEDULER_SECRET: Used to authenticate Cloud Scheduler requests
# Must be a strong, unique secret. Never use default values in production.
INTERNAL_SCHEDULER_SECRET=
# CORS_ORIGINS: Comma-separated list of allowed CORS origins (required in production)
# IMPORTANT: With allow_credentials=True (cookie-based auth), wildcard (*) is NOT allowed by browsers
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# APP_URL: Public base URL of the application (required in production).
# Used to construct deep-links in outbound emails (password-reset, email-verification).
# Must be an https:// URL with no trailing slash.
# Example: https://app.yourschool.edu
APP_URL=
# BEHIND_PROXY: Set to 'true' if app is behind a load balancer/CDN (A9 security fix)
BEHIND_PROXY=false

# Cloud Scheduler IP Ranges (H1 security)
# Comma-separated list of allowed CIDR ranges for Cloud Scheduler
CLOUD_SCHEDULER_IP_RANGES=

# SSO/OAuth connector config (Phase 2 prep — self-hosted SSO only; leave blank)
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Feature Flags
# FEATURE_FLAG_MFA_ENABLED: Set to 'true' to enforce TOTP MFA for roles listed
#   in MFA_REQUIRED_ROLES (default: Admin, SuperAdmin). Before enabling in production:
#   1. Ensure ENCRYPTION_KEY is configured — MFA secrets are Fernet-encrypted at rest.
#   2. Inform affected users; they enrol at POST /auth/mfa/setup (returns a QR code URI
#      compatible with Google Authenticator, Authy, etc.).
#   3. After enrolment every login for those roles requires the current 6-digit TOTP code.
#   Set to 'false' (default) to disable MFA enforcement entirely.
# FEATURE_FLAG_SSO_ENABLED: Phase 2 prep — leave false until SSO_PROVIDER is configured.
FEATURE_FLAG_PROVIDER=configuration-engine
FEATURE_FLAG_MFA_ENABLED=false
FEATURE_FLAG_SSO_ENABLED=false
FEATURE_FLAG_OBSERVATION_REOPEN_ENABLED=false
FEATURE_FLAG_SAVED_FILTERS_ENABLED=false

# School Timezone (required by Compliance Scheduler)
DEFAULT_SCHOOL_TIMEZONE=Asia/Kolkata

# Media / Document Storage — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
FILE_UPLOAD_MAX_SIZE_MB=10
EVIDENCE_RETENTION_PERIOD_DAYS=90

# Async Job Queue (AQ3 - Phase 1 default: Upstash Redis)
# Options: memory, sqs, kafka, upstash-qstash, redis
QUEUE_PROVIDER=redis
QUEUE_CONNECTION_STRING=redis://default:password@host:port

# Cache / Session — Redis-class store
REDIS_URL=

# Idempotency Configuration
IDEMPOTENCY_EXPIRY_HOURS=24

# Compliance/Duplicate/Grace-Period Config Defaults
DUPLICATE_DETECTION_WINDOW_MINUTES=60
GRACE_PERIOD_HOURS=24
SCHEDULER_OUTAGE_GRACE_EXTENSION=2

# Search Index — Meilisearch (self-hosted via docker-compose)
SEARCH_INDEX_URL=http://localhost:7700
SEARCH_INDEX_API_KEY=
SEARCH_INDEXING_LAG_TARGET_SECONDS=60

# Notification Channel Providers
# Email provider: Resend (3,000 emails/month free) — also delivers password-reset tokens.
# If EMAIL_PROVIDER_API_KEY is EMPTY (self-hosted default), password-reset tokens are
# persisted as in-app notification rows instead of emailed; an operator delivers them
# out-of-band, or admins issue them directly via POST /api/v1/users/{id}/set-password.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# Observability
LOG_LEVEL=info
APM_PROVIDER=
ERROR_TRACKING_DSN=

# Sentry Error Monitoring
# Backend Sentry DSN
SENTRY_BACKEND_DSN=
# Frontend Sentry DSN
VITE_SENTRY_FRONTEND_DSN=
