# Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.production and fill in actual values
# Never commit files with real secret values

# Database — Neon (serverless PostgreSQL)
DATABASE_URL=
# Read replica for reports/dashboards (R-61/Architecture §14).
# Leave blank in dev (falls back to DATABASE_URL with read-only transaction flag).
# In production: point at a Neon read-replica branch URL.
DATABASE_READ_REPLICA_URL=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_API_KEY=

# Auth — Neon Auth (Better Auth-backed)
NEON_AUTH_PROJECT_ID=
NEON_AUTH_PUBLISHABLE_KEY=
NEON_AUTH_SECRET_KEY=
MFA_REQUIRED_ROLES=Admin,SuperAdmin
SESSION_TIMEOUT_MINUTES=30

# SSO/OAuth connector config (Phase 2 prep - leave blank in Phase 1)
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# School Timezone (required by Compliance Scheduler)
DEFAULT_SCHOOL_TIMEZONE=Asia/Kolkata

# Media / Document Storage — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
FILE_UPLOAD_MAX_SIZE_MB=10
EVIDENCE_RETENTION_PERIOD_DAYS=90

# Async Job Queue (AQ3 - Phase 1 default: Upstash QStash)
QUEUE_PROVIDER=upstash-qstash
QUEUE_CONNECTION_STRING=

# Cache / Session — Redis-class store
REDIS_URL=

# Compliance/Duplicate/Grace-Period Config Defaults
DUPLICATE_DETECTION_WINDOW_MINUTES=60
GRACE_PERIOD_HOURS=24
SCHEDULER_OUTAGE_GRACE_EXTENSION=2

# Search Index — Meilisearch (self-hosted via docker-compose)
SEARCH_INDEX_URL=http://localhost:7700
SEARCH_INDEX_API_KEY=
SEARCH_INDEXING_LAG_TARGET_SECONDS=60

# Notification Channel Providers
# Email provider: Resend (3,000 emails/month free)
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# Feature Flags
FEATURE_FLAG_PROVIDER=configuration-engine

# Observability
LOG_LEVEL=info
APM_PROVIDER=
ERROR_TRACKING_DSN=
